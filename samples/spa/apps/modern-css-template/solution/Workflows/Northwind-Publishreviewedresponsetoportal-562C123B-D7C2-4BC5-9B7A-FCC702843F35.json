            "Verify_existing_response": {
              "type": "If",
              "expression": "@not(and(equals(outputs('Read_existing_response')?['body/_regardingobjectid_value'], outputs('Read_case')?['body/incidentid']), equals(outputs('Read_existing_response')?['body/subject'], if(equals(outputs('Existing_receipt')?['schemaVersion'], 4), '*WEB* Reviewed support response', if(equals(outputs('Existing_receipt')?['schemaVersion'], 3), '*WEB* Support email response', '*WEB* AI-assisted support response'))), equals(outputs('Read_existing_response')?['body/adx_portalcommentdirectioncode'], 2), equals(outputs('Read_existing_response')?['body/description'], outputs('Existing_receipt')?['approvedText'])))",
              "actions": {
                "Stop_changed_response": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "PublishedResponseChanged",
                      "message": "The existing published response no longer matches its receipt. Review it in Dynamics 365; it was not recreated or overwritten."
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Read_existing_response": [
                  "Succeeded"
                ]
              }
            },
            "Already_published": {
              "type": "Compose",
              "inputs": {
                "status": "AlreadyPublished",
                "message": "This email already has a published snapshot. Later Send attempts or draft edits do not replace it; use a new email for a follow-up.",
                "caseId": "@outputs('Read_case')?['body/incidentid']",
                "commentId": "@outputs('Existing_receipt')?['commentId']",
                "portalCaseUrl": "@concat(parameters('Modern CSS - Portal URL (ppst_ModernCss_PortalUrl)'), '/cases/', outputs('Read_case')?['body/incidentid'])"
              },
              "runAfter": {
                "Verify_existing_response": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Convert_approved_snapshot_to_text": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_conversionservice",
