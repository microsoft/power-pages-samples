                "actions": {
                  "Stop_changed_case_audience": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "code": "ApprovedCaseChanged",
                        "message": "The approved case audience changed before publication. Nothing was published; review the approval and case ownership."
