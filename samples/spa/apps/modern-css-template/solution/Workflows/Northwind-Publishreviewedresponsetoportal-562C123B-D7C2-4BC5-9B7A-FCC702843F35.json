          "expression": "@not(and(equals(outputs('Read_case')?['body/caseorigincode'], 3), equals(outputs('Read_case')?['body/_createdby_value'], parameters('Modern CSS - Portal application user ID (ppst_ModernCss_PortalApplicationUserId)')), not(empty(outputs('Read_case')?['body/customerid_contact']?['contactid'])), equals(outputs('Read_case')?['body/customerid_contact']?['contactid'], outputs('Approval')?['contactId']), equals(outputs('Read_case')?['body/_customerid_value'], outputs('Approval')?['contactId'])))",
          "actions": {
            "Stop_changed_approved_case": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "ApprovedCaseChanged",
