          "type": "If",
          "expression": "@not(and(equals(triggerBody()?['subject'], 'Northwind portal: Reviewed Send approval'), equals(triggerBody()?['isdocument'], false), equals(triggerBody()?['_createdby_value'], parameters('Modern CSS - Approval writer (SYSTEM) user ID (ppst_ModernCss_ApprovalWriterUserId)')), equals(outputs('Approval')?['schemaVersion'], 1), equals(outputs('Approval')?['approvalMethod'], 'NativeSend'), equals(outputs('Approval')?['outsideTransaction'], true), equals(triggerBody()?['_objectid_value'], outputs('Approval')?['caseId']), not(empty(outputs('Approval')?['emailId'])), not(empty(outputs('Approval')?['contactId'])), not(empty(outputs('Approval')?['approvedBy'])), not(empty(outputs('Approval')?['approvedAt'])), not(empty(outputs('Approval')?['sourceEmailVersion'])), not(equals(outputs('Approval')?['htmlBase64'], null))))",
          "actions": {
