            },
            "Require_matching_completed_receipt": {
              "type": "If",
              "expression": "@not(and(equals(first(outputs('Find_publication_receipt')?['body/value'])?['subject'], 'Northwind portal: Approved response publication'), equals(first(outputs('Find_publication_receipt')?['body/value'])?['_objectid_value'], outputs('Read_case')?['body/incidentid']), or(and(equals(outputs('Existing_receipt')?['schemaVersion'], 4), equals(outputs('Existing_receipt')?['publicationMethod'], 'NativeSend'), not(empty(outputs('Existing_receipt')?['approvalRequestId'])), not(empty(outputs('Existing_receipt')?['sourceEmailVersion'])), not(empty(outputs('Existing_receipt')?['approvedBy'])), not(empty(outputs('Existing_receipt')?['approvedAt']))), and(equals(outputs('Existing_receipt')?['schemaVersion'], 3), equals(outputs('Existing_receipt')?['publicationMethod'], 'SentEmail'), not(empty(outputs('Existing_receipt')?['sourceEmailVersion'])), not(empty(outputs('Existing_receipt')?['sourceSentOn']))), equals(outputs('Existing_receipt')?['schemaVersion'], 1), and(equals(outputs('Existing_receipt')?['schemaVersion'], 2), not(empty(outputs('Existing_receipt')?['sourceEmailVersion'])), not(empty(outputs('Existing_receipt')?['approvalId'])), not(empty(outputs('Existing_receipt')?['approvedBy'])))), equals(outputs('Existing_receipt')?['status'], 'Published'), equals(outputs('Existing_receipt')?['emailId'], outputs('Approval')?['emailId']), equals(outputs('Existing_receipt')?['caseId'], outputs('Read_case')?['body/incidentid']), equals(outputs('Existing_receipt')?['contactId'], outputs('Read_case')?['body/customerid_contact']?['contactid']), not(empty(outputs('Existing_receipt')?['approvedText'])), not(empty(outputs('Existing_receipt')?['commentId']))))",
              "actions": {
                "Stop_conflicting_or_unconfirmed_publication": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "PublicationConflictOrUnconfirmed",
