{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "msdyn_CustomerServiceCaseClosureFollowup.shared_commondataserviceforapps.msdyn_sharedcommondataserviceforapps"
        },
        "runtimeSource": "embedded"
      },
      "shared_conversionservice": {
        "api": {
          "name": "shared_conversionservice"
        },
        "connection": {
          "connectionReferenceLogicalName": "cr719_northwindportalresponseconversion"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "4.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "Modern CSS - Portal application user ID (ppst_ModernCss_PortalApplicationUserId)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "ppst_ModernCss_PortalApplicationUserId"
          }
        },
        "Modern CSS - Portal URL (ppst_ModernCss_PortalUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "ppst_ModernCss_PortalUrl"
          }
        }
      },
      "triggers": {
        "When_case_email_Send_is_accepted": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "connectionName": "shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "email",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "statecode,statuscode",
              "subscriptionRequest/filterexpression": "directioncode eq true and statecode eq 1 and statuscode eq 6 and _regardingobjectid_value ne null"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Read_sent_email": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "GetItem",
              "connectionName": "shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "emails",
              "recordId": "@triggerBody()?['activityid']",
              "$select": "activityid,description,directioncode,statecode,statuscode,versionnumber,_regardingobjectid_value",
              "$expand": "regardingobjectid_incident_email($select=incidentid)"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "Require_outgoing_case_email": {
          "type": "If",
          "expression": "@not(and(equals(outputs('Read_sent_email')?['body/directioncode'], true), not(empty(outputs('Read_sent_email')?['body/regardingobjectid_incident_email']?['incidentid']))))",
          "actions": {
            "Record_not_case_email": {
              "type": "Compose",
              "inputs": {
                "status": "Skipped",
                "reason": "The accepted Send is not an outgoing case email."
              }
            },
            "Stop_not_case_email": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              },
              "runAfter": {
                "Record_not_case_email": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Read_sent_email": [
              "Succeeded"
            ]
          }
        },
        "Read_case": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "GetItem",
              "connectionName": "shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "incidents",
              "recordId": "@outputs('Read_sent_email')?['body/regardingobjectid_incident_email']?['incidentid']",
              "$select": "incidentid,ticketnumber,caseorigincode,_createdby_value,_customerid_value",
              "$expand": "customerid_contact($select=contactid)"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Require_outgoing_case_email": [
              "Succeeded"
            ]
          }
        },
        "Require_Northwind_personal_case": {
          "type": "If",
          "expression": "@not(and(equals(outputs('Read_case')?['body/caseorigincode'], 3), equals(outputs('Read_case')?['body/_createdby_value'], parameters('Modern CSS - Portal application user ID (ppst_ModernCss_PortalApplicationUserId)')), not(empty(outputs('Read_case')?['body/customerid_contact']?['contactid'])), equals(outputs('Read_case')?['body/_customerid_value'], outputs('Read_case')?['body/customerid_contact']?['contactid'])))",
          "actions": {
            "Record_not_portal_case": {
              "type": "Compose",
              "inputs": {
                "status": "Skipped",
                "reason": "The email concerns a case that is not a Northwind portal Web case with a Contact customer."
              }
            },
            "Stop_not_portal_case": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              },
              "runAfter": {
                "Record_not_portal_case": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Read_case": [
              "Succeeded"
            ]
          }
        },
        "Read_To_recipients": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "connectionName": "shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "activityparties",
              "$select": "activitypartyid,participationtypemask,_partyid_value",
              "$filter": "@concat('_activityid_value eq ', outputs('Read_sent_email')?['body/activityid'], ' and participationtypemask eq 2')",
              "$expand": "partyid_contact($select=contactid)",
              "$top": 2
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Require_Northwind_personal_case": [
              "Succeeded"
            ]
          }
        },
        "Require_case_Contact_as_sole_recipient": {
          "type": "If",
          "expression": "@not(and(equals(length(outputs('Read_To_recipients')?['body/value']), 1), equals(first(outputs('Read_To_recipients')?['body/value'])?['partyid_contact']?['contactid'], outputs('Read_case')?['body/customerid_contact']?['contactid'])))",
          "actions": {
            "Record_not_portal_response": {
              "type": "Compose",
              "inputs": {
                "status": "Skipped",
                "reason": "The case Contact is not the email's only To recipient, so it is not a portal response. The email continues through normal mail processing."
              }
            },
            "Stop_not_portal_response": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              },
              "runAfter": {
                "Record_not_portal_response": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Read_To_recipients": [
              "Succeeded"
            ]
          }
        },
        "Require_locked_sent_email": {
          "type": "If",
          "expression": "@not(and(equals(outputs('Read_sent_email')?['body/statecode'], 1), or(equals(outputs('Read_sent_email')?['body/statuscode'], 6), equals(outputs('Read_sent_email')?['body/statuscode'], 7), equals(outputs('Read_sent_email')?['body/statuscode'], 3))))",
          "actions": {
            "Stop_unlocked_email": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "SendNotLocked",
                  "message": "The email reopened (for example, as Failed) before its sent text was read, so the reviewed text cannot be confirmed. Nothing was published. Resolve the send failure and Send again."
                }
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Require_case_Contact_as_sole_recipient": [
              "Succeeded"
            ]
          }
        },
        "Find_publication_receipt": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "connectionName": "shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "annotations",
              "$select": "annotationid,subject,notetext,_objectid_value",
              "$filter": "@concat('annotationid eq ', outputs('Read_sent_email')?['body/activityid'])",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Require_locked_sent_email": [
              "Succeeded"
            ]
          }
        },
        "Publication_exists": {
          "type": "If",
          "expression": "@greater(length(outputs('Find_publication_receipt')?['body/value']), 0)",
          "actions": {
            "Existing_receipt": {
              "type": "Compose",
              "inputs": "@json(first(outputs('Find_publication_receipt')?['body/value'])?['notetext'])",
              "runAfter": {}
            },
            "Require_matching_completed_receipt": {
              "type": "If",
              "expression": "@not(and(equals(first(outputs('Find_publication_receipt')?['body/value'])?['subject'], 'Northwind portal: Approved response publication'), equals(first(outputs('Find_publication_receipt')?['body/value'])?['_objectid_value'], outputs('Read_case')?['body/incidentid']), or(and(equals(outputs('Existing_receipt')?['schemaVersion'], 5), equals(outputs('Existing_receipt')?['publicationMethod'], 'SendAccepted'), not(empty(outputs('Existing_receipt')?['sourceEmailVersion'])), not(empty(outputs('Existing_receipt')?['approvedBy'])), not(empty(outputs('Existing_receipt')?['approvedAt']))), and(equals(outputs('Existing_receipt')?['schemaVersion'], 4), equals(outputs('Existing_receipt')?['publicationMethod'], 'NativeSend'), not(empty(outputs('Existing_receipt')?['approvalRequestId'])), not(empty(outputs('Existing_receipt')?['sourceEmailVersion'])), not(empty(outputs('Existing_receipt')?['approvedBy'])), not(empty(outputs('Existing_receipt')?['approvedAt']))), and(equals(outputs('Existing_receipt')?['schemaVersion'], 3), equals(outputs('Existing_receipt')?['publicationMethod'], 'SentEmail'), not(empty(outputs('Existing_receipt')?['sourceEmailVersion'])), not(empty(outputs('Existing_receipt')?['sourceSentOn']))), equals(outputs('Existing_receipt')?['schemaVersion'], 1), and(equals(outputs('Existing_receipt')?['schemaVersion'], 2), not(empty(outputs('Existing_receipt')?['sourceEmailVersion'])), not(empty(outputs('Existing_receipt')?['approvalId'])), not(empty(outputs('Existing_receipt')?['approvedBy'])))), equals(outputs('Existing_receipt')?['status'], 'Published'), equals(outputs('Existing_receipt')?['emailId'], outputs('Read_sent_email')?['body/activityid']), equals(outputs('Existing_receipt')?['caseId'], outputs('Read_case')?['body/incidentid']), equals(outputs('Existing_receipt')?['contactId'], outputs('Read_case')?['body/customerid_contact']?['contactid']), not(empty(outputs('Existing_receipt')?['approvedText'])), not(empty(outputs('Existing_receipt')?['commentId']))))",
              "actions": {
                "Stop_conflicting_or_unconfirmed_publication": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "PublicationConflictOrUnconfirmed",
                      "message": "This email has a different or unfinished publication receipt. Review its reserved comment ID and prior run; do not resend the email or create another response blindly."
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Existing_receipt": [
                  "Succeeded"
                ]
              }
            },
            "Read_existing_response": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "connectionName": "shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "adx_portalcomments",
                  "recordId": "@outputs('Existing_receipt')?['commentId']",
                  "$select": "activityid,subject,description,_regardingobjectid_value,adx_portalcommentdirectioncode"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Require_matching_completed_receipt": [
                  "Succeeded"
                ]
              }
            },
            "Verify_existing_response": {
              "type": "If",
              "expression": "@not(and(equals(outputs('Read_existing_response')?['body/_regardingobjectid_value'], outputs('Read_case')?['body/incidentid']), equals(outputs('Read_existing_response')?['body/subject'], if(greaterOrEquals(outputs('Existing_receipt')?['schemaVersion'], 4), '*WEB* Reviewed support response', if(equals(outputs('Existing_receipt')?['schemaVersion'], 3), '*WEB* Support email response', '*WEB* AI-assisted support response'))), equals(outputs('Read_existing_response')?['body/adx_portalcommentdirectioncode'], 2), equals(outputs('Read_existing_response')?['body/description'], outputs('Existing_receipt')?['approvedText'])))",
              "actions": {
                "Stop_changed_response": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "PublishedResponseChanged",
                      "message": "The existing published response no longer matches its receipt. Review it in Dynamics 365; it was not recreated or overwritten."
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Read_existing_response": [
                  "Succeeded"
                ]
              }
            },
            "Already_published": {
              "type": "Compose",
              "inputs": {
                "status": "AlreadyPublished",
                "message": "This email already has a published response. A later Send of the same email does not replace it; use a new email for a follow-up.",
                "caseId": "@outputs('Read_case')?['body/incidentid']",
                "commentId": "@outputs('Existing_receipt')?['commentId']",
                "portalCaseUrl": "@concat(parameters('Modern CSS - Portal URL (ppst_ModernCss_PortalUrl)'), '/cases/', outputs('Read_case')?['body/incidentid'])"
              },
              "runAfter": {
                "Verify_existing_response": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Convert_approved_snapshot_to_text": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_conversionservice",
                    "operationId": "HtmlToText",
                    "connectionName": "shared_conversionservice"
                  },
                  "parameters": {
                    "Content": "@coalesce(outputs('Read_sent_email')?['body/description'], '')"
                  }
                },
                "runAfter": {}
              },
              "Approved_text": {
                "type": "Compose",
                "inputs": "@trim(body('Convert_approved_snapshot_to_text'))",
                "runAfter": {
                  "Convert_approved_snapshot_to_text": [
                    "Succeeded"
                  ]
                }
              },
              "Require_publishable_text": {
                "type": "If",
                "expression": "@not(and(not(empty(outputs('Approved_text'))), lessOrEquals(length(outputs('Approved_text')), 4000)))",
                "actions": {
                  "Stop_invalid_approved_text": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "code": "InvalidApprovedText",
                        "message": "The sent email must contain 1-4,000 converted characters. Nothing was truncated or published. Email delivery is independent; do not resend merely to recover a portal publication."
                      }
                    }
                  }
                },
                "else": {
                  "actions": {}
                },
                "runAfter": {
                  "Approved_text": [
                    "Succeeded"
                  ]
                }
              },
              "Read_case_before_publish": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "GetItem",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "incidents",
                    "recordId": "@outputs('Read_case')?['body/incidentid']",
                    "$select": "incidentid,caseorigincode,_createdby_value,_customerid_value",
                    "$expand": "customerid_contact($select=contactid)"
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "runAfter": {
                  "Require_publishable_text": [
                    "Succeeded"
                  ]
                }
              },
              "Require_unchanged_case_audience": {
                "type": "If",
                "expression": "@not(and(equals(outputs('Read_case_before_publish')?['body/caseorigincode'], 3), equals(outputs('Read_case_before_publish')?['body/_createdby_value'], parameters('Modern CSS - Portal application user ID (ppst_ModernCss_PortalApplicationUserId)')), equals(outputs('Read_case_before_publish')?['body/customerid_contact']?['contactid'], outputs('Read_case')?['body/customerid_contact']?['contactid']), equals(outputs('Read_case_before_publish')?['body/_customerid_value'], outputs('Read_case')?['body/customerid_contact']?['contactid'])))",
                "actions": {
                  "Stop_changed_case_audience": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "code": "ApprovedCaseChanged",
                        "message": "The case audience changed before publication. Nothing was published; review the case ownership and the sent email."
                      }
                    }
                  }
                },
                "else": {
                  "actions": {}
                },
                "runAfter": {
                  "Read_case_before_publish": [
                    "Succeeded"
                  ]
                }
              },
              "New_comment_id": {
                "type": "Compose",
                "inputs": "@guid()",
                "runAfter": {
                  "Require_unchanged_case_audience": [
                    "Succeeded"
                  ]
                }
              },
              "Publication_receipt": {
                "type": "Compose",
                "inputs": {
                  "schemaVersion": 5,
                  "status": "Reserved",
                  "emailId": "@outputs('Read_sent_email')?['body/activityid']",
                  "caseId": "@outputs('Read_case')?['body/incidentid']",
                  "contactId": "@outputs('Read_case')?['body/customerid_contact']?['contactid']",
                  "commentId": "@outputs('New_comment_id')",
                  "approvedText": "@outputs('Approved_text')",
                  "sourceEmailVersion": "@string(outputs('Read_sent_email')?['body/versionnumber'])",
                  "flowRunId": "@workflow()?['run']?['name']",
                  "publicationMethod": "SendAccepted",
                  "approvedBy": "@triggerBody()?['_modifiedby_value']",
                  "approvedAt": "@triggerBody()?['modifiedon']"
                },
                "runAfter": {
                  "New_comment_id": [
                    "Succeeded"
                  ]
                }
              },
              "Reserve_publication": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "CreateRecord",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "annotations",
                    "item/annotationid": "@outputs('Read_sent_email')?['body/activityid']",
                    "item/subject": "Northwind portal: Approved response publication",
                    "item/notetext": "@string(outputs('Publication_receipt'))",
                    "item/isdocument": false,
                    "item/objectid_incident@odata.bind": "@concat('incidents(', outputs('Read_case')?['body/incidentid'], ')')"
                  },
                  "authentication": "@parameters('$authentication')",
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {
                  "Publication_receipt": [
                    "Succeeded"
                  ]
                }
              },
              "Create_portal_response": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "CreateRecord",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "adx_portalcomments",
                    "item/activityid": "@outputs('New_comment_id')",
                    "item/subject": "*WEB* Reviewed support response",
                    "item/description": "@outputs('Publication_receipt')?['approvedText']",
                    "item/adx_portalcommentdirectioncode": 2,
                    "item/regardingobjectid_incident_adx_portalcomment@odata.bind": "@concat('incidents(', outputs('Read_case')?['body/incidentid'], ')')"
                  },
                  "authentication": "@parameters('$authentication')",
                  "retryPolicy": {
                    "type": "none"
                  }
                },
                "runAfter": {
                  "Reserve_publication": [
                    "Succeeded"
                  ]
                }
              },
              "Read_published_response": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "GetItem",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "adx_portalcomments",
                    "recordId": "@outputs('New_comment_id')",
                    "$select": "activityid,subject,description,_regardingobjectid_value,adx_portalcommentdirectioncode"
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "runAfter": {
                  "Create_portal_response": [
                    "Succeeded"
                  ]
                }
              },
              "Verify_published_response": {
                "type": "If",
                "expression": "@not(and(equals(outputs('Read_published_response')?['body/activityid'], outputs('New_comment_id')), equals(outputs('Read_published_response')?['body/_regardingobjectid_value'], outputs('Read_case')?['body/incidentid']), equals(outputs('Read_published_response')?['body/subject'], '*WEB* Reviewed support response'), equals(outputs('Read_published_response')?['body/adx_portalcommentdirectioncode'], 2), equals(outputs('Read_published_response')?['body/description'], outputs('Publication_receipt')?['approvedText'])))",
                "actions": {
                  "Stop_unconfirmed_response": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "code": "PublicationUnconfirmed",
                        "message": "The saved response could not be confirmed. Review the reserved comment ID before any manual retry."
                      }
                    }
                  }
                },
                "else": {
                  "actions": {}
                },
                "runAfter": {
                  "Read_published_response": [
                    "Succeeded"
                  ]
                }
              },
              "Complete_publication_receipt": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "UpdateOnlyRecord",
                    "connectionName": "shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "annotations",
                    "recordId": "@outputs('Read_sent_email')?['body/activityid']",
                    "item/notetext": "@string(setProperty(setProperty(outputs('Publication_receipt'), 'status', 'Published'), 'publishedAt', utcNow()))"
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "runAfter": {
                  "Verify_published_response": [
                    "Succeeded"
                  ]
                }
              },
              "Published": {
                "type": "Compose",
                "inputs": {
                  "status": "Published",
                  "message": "The accepted Send was published to the portal. This flow does not send or retry email.",
                  "caseId": "@outputs('Read_case')?['body/incidentid']",
                  "commentId": "@outputs('New_comment_id')",
                  "portalCaseUrl": "@concat(parameters('Modern CSS - Portal URL (ppst_ModernCss_PortalUrl)'), '/cases/', outputs('Read_case')?['body/incidentid'])"
                },
                "runAfter": {
                  "Complete_publication_receipt": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "runAfter": {
            "Find_publication_receipt": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}