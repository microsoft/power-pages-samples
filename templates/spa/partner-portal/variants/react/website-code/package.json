{
  "name": "contoso-partner-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc -b && vite build && node scripts/postbuild.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:a11y": "node tests/e2e/run.mjs --only a11y",
    "test:smoke": "node tests/e2e/run.mjs --only smoke"
  },
  "dependencies": {
    "@fluentui/react-charts": "^9.3.27",
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.344",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "1.64.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.0"
  }
}
