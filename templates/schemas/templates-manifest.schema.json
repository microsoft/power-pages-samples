{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/microsoft/power-pages-samples/templates/schemas/templates-manifest.schema.json",
  "title": "Power Pages templates manifest",
  "type": "object",
  "required": [
    "templates"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "description",
          "kind",
          "keywords",
          "audience",
          "previewImages",
          "requiredDataverseLanguages",
          "author",
          "variants"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "spa",
              "traditional"
            ]
          },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "audience": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "admins",
                "developers",
                "makers",
                "partners"
              ]
            }
          },
          "previewImages": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^.+\\.png$"
            }
          },
          "seedDataPath": {
            "type": "string",
            "pattern": "^.+\\.json$"
          },
          "requiredDataverseLanguages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "variants": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "angular": {
                "$ref": "#/$defs/templateVariant"
              },
              "astro": {
                "$ref": "#/$defs/templateVariant"
              },
              "react": {
                "$ref": "#/$defs/templateVariant"
              },
              "vue": {
                "$ref": "#/$defs/templateVariant"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "templateVariant": {
      "type": "object",
      "required": [
        "templateVersion",
        "solutionPath",
        "spaCodePath"
      ],
      "additionalProperties": false,
      "properties": {
        "templateVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?$"
        },
        "solutionPath": {
          "type": "string",
          "pattern": "^.+\\.zip$"
        },
        "spaCodePath": {
          "type": "string",
          "pattern": "^.+/spa-code$"
        },
        "previewImages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^.+\\.png$"
          }
        },
        "seedDataPath": {
          "type": "string",
          "pattern": "^.+\\.json$"
        },
        "requiredDataverseLanguages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
